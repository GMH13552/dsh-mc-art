# 本地美术项目：你自己的资产，不上传（mod 骨架要，单独放行）
/examplemod/*
!/examplemod/mod
/eyeball_tree/*

# 构建产物 / 运行目录 / 依赖缓存
**/build/
**/run/
**/.gradle/
**/__pycache__/
*.pyc
**/node_modules/

# 门禁自己生成的夹具
tools/mcart-plugin/.*-fixture/

# skill 的运行缓存（参考目录扫描结果）
skills/mc-art/references/.cache/

# 日志与系统垃圾
*.log
.DS_Store
Thumbs.db

# 其它会话留下的产物目录 / 个人笔记：这是"工具"仓库，不带创作数据
/outputs/
/villagers/
/vanilla3d/
/AGENT.md

# 面板包里那份"模式 + skill"是打包时由 panel/vendor.mjs 生成的（发布物需要它，仓库不留副本）
panel/preset/

# 发布前门禁的专属词表（本机才有）
panel/private-markers.txt

# 协作简报与证据（不属于发布物）
/.team/
